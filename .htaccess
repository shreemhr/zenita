DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# These two event pages were removed permanently; tell search engines
# with a 410 Gone instead of a plain 404, so they de-index faster.
RewriteRule ^events/christmas-luxe(/.*)?$ - [G,L]
RewriteRule ^events/mesa-de-gracias(/.*)?$ - [G,L]

# Redirect /index.html (site root) to /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Redirect /any/path/index.html to /any/path/
RewriteCond %{THE_REQUEST} \s/+(.+)/index\.html[\s?] [NC]
RewriteRule ^(.+)/index\.html$ /$1/ [R=301,L]
</IfModule>
